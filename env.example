# .env.example
# Copy to .env and fill in real values.
# .env is in .gitignore — never commit it.

# Database — direct PostgreSQL RDS connection
DB_HOST=chonkychonk.xxxxx.ca-central-1.rds.amazonaws.com
DB_PORT=5432
DB_USER=chonky_admin
DB_PASSWORD=your_secure_password_here
DB_NAME=chonky

# VPC Configuration — required for Lambda to access RDS in same VPC
VPC_ID=vpc-xxxxxxxx
SUBNET_IDS=subnet-xxxxxxxx,subnet-yyyyyyyy
SECURITY_GROUP_ID=sg-xxxxxxxx

# Stripe
STRIPE_SECRET_KEY=sk_test_...

# Email (SES)
EMAIL_FROM_ADDRESS=orders@chonkychonk.com
SUPPORT_EMAIL=support@chonkychonk.com
LOW_STOCK_RECIPIENT=ops@chonkychonk.com

# WebSocket — fill in after first deploy outputs it
APIGW_WS_ENDPOINT=https://xxxxxxxxxx.execute-api.ca-central-1.amazonaws.com/prod

# SNS — fill in after first deploy outputs it
SNS_OPS_TOPIC_ARN=arn:aws:sns:ca-central-1:123456789012:chonkychonk-ops-alerts

# Cognito — leave empty until configured
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=
