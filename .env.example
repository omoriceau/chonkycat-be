# Copy this file to .env.local (gitignored) and fill in real values for
# local development. See "Local development" in README.md for details.

# ---- Core (all Lambdas) ----
ENVIRONMENT=dev
EVENT_BUS_NAME=chonkychonk-bus
AWS_REGION=us-east-1
DEV_EMAIL=dev@example.com

# Skip real DynamoDB entirely and run against an in-memory mock —
# the fastest way to run locally without any AWS access at all.
LOCAL_MOCK_DB=true

# ---- DynamoDB table names (ignored if LOCAL_MOCK_DB=true) ----
USERS_TABLE_NAME=chonky-users-dev
PRODUCTS_TABLE_NAME=chonky-products-dev
ORDERS_TABLE_NAME=chonky-orders-dev
PAYMENTS_TABLE_NAME=chonky-payments-dev
PROMOTIONS_TABLE_NAME=chonky-promotions-dev

# ---- Cognito ----
COGNITO_USER_POOL_ID=
CUSTOMER_COGNITO_USER_POOL_ID=
CUSTOMER_COGNITO_APP_CLIENT_ID=

# ---- Stripe ----
STRIPE_SECRET_KEY_SECRET_NAME=chonky/dev/stripe_secret_key
STRIPE_WEBHOOK_SECRET_NAME=chonky/dev/stripe_webhook_secret
# Local fallback, used if Secrets Manager lookup fails/isn't reachable.
# Get a test key from https://dashboard.stripe.com/test/apikeys — never commit a real one.
STRIPE_SECRET_KEY=sk_test_replace_with_your_own_test_key

# ---- Products (image upload) ----
PRODUCT_IMAGES_BUCKET=chonky-images-dev

# ---- Email (email_service) ----
EMAIL_FROM_ADDRESS=no-reply@example.com
EMAIL_FROM_NAME=ChonkyChonk
SUPPORT_EMAIL=
SES_CONFIGURATION_SET=
